# Copy to backend/.env. Never commit real keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=LearnLens AI
OPENROUTER_TIMEOUT_SECONDS=25

# Optional second provider; use a free-tier key/account and monitor its quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional server-side Supabase credentials only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

AI_ENABLED=true
DEMO_MODE=false
RAG_ENABLED=true
DEMO_TIME_TRAVEL=false
MAX_UPLOAD_MB=3.5
FRONTEND_ORIGINS=http://localhost:3000
LEARNLENS_CACHE_PATH=
